{
  "datasets": [
    {
      "name": "934122c0",
      "displayName": "earthquake_data_final",
      "queryLines": [
        "SELECT * FROM youtube_dev.youtubesilver.earthquake_data_final"
      ]
    },
    {
      "name": "8995bec7",
      "displayName": "Earthquake_Magnitude_Distribution",
      "queryLines": [
        "select \r\n",
        "  count(*) as total_magnitude_bucket,\r\n",
        "  magnitude_bucket\r\n",
        "from (\r\n",
        "    select \r\n",
        "      case \r\n",
        "        when mag < 2 then 'Micro (<2)'\r\n",
        "        when mag between 2 and 3 then 'Minor (2-3)'\r\n",
        "        when mag between 3 and 4 then 'Light (3-4)'\r\n",
        "        else 'Major (4+)' \r\n",
        "      end as magnitude_bucket\r\n",
        "    from earthquake_data_final\r\n",
        ")\r\n",
        "group by magnitude_bucket"
      ],
      "catalog": "youtube_dev",
      "schema": "youtubesilver"
    },
    {
      "name": "e8fec4fc",
      "displayName": "EarthQuake_by_Country",
      "queryLines": [
        "SELECT  \r\n",
        "  count(*) AS event_count,\r\n",
        "  -- case \r\n",
        "  --   when size(split(place, ', ')) = 1 then split(place, ', ')[0] \r\n",
        "  --   else split(place, ', ')[1] \r\n",
        "  -- end AS country\r\n",
        "  try_element_at(split(place, ', '), 2) as country\r\n",
        "FROM (\r\n",
        "  SELECT  \r\n",
        "    time,\r\n",
        "    title,\r\n",
        "    mag,\r\n",
        "    longitude,\r\n",
        "    place,\r\n",
        "    latitude\r\n",
        "  from earthquake_data_final\r\n",
        ")\r\n",
        "group by country"
      ],
      "catalog": "youtube_dev",
      "schema": "youtubesilver"
    }
  ],
